<%- layout("/layouts/boilerplate.ejs") %>

<div class="container success-wrapper py-4">

  <div class="success-card text-center my-5">

    <div class="success-icon">
      ✓
    </div>

    <h2 class="success-title">Payment Successful!</h2>
    <p class="success-subtitle">
      Your parking slot has been successfully reserved.
    </p>

    <div class="success-details text-start">

      <div class="success-row">
        <span><strong>Name:</strong></span>
        <span><%= booking.customerName %></span>
      </div>

      <div class="success-row">
        <span><strong>Email:</strong></span>
        <span><%= booking.customerEmail %></span>
      </div>

      <div class="success-row">
        <span><strong>Location:</strong></span>
        <span><%= booking.spot?.location.split(", ").slice(0, 3).join(", ") %></span>
      </div>
      <div class="success-row">
        <span><strong>Date:</strong></span>
        <span><%= booking.date.toDateString() %></span>
      </div>

      <div class="success-row">
        <span><strong>Time:</strong></span>
        <span><%= booking.startTime %> - <%= booking.endTime %></span>
      </div>

      <div class="success-row">
        <span><strong>Vehicle:</strong></span>
        <span><%= booking.vehicleNumber %></span>
      </div>

      <hr>

      <div class="success-row success-total">
        <span>Total Paid:</span>
        <span>₹ <%= booking.totalPrice %></span>
      </div>

      <a href="/booking/<%= booking._id %>/receipt/download" class="btn mt-2 teal-main-btn fw-bold">
        Download Receipt
      </a>
    </div>

    <a href="/parking-slots" class="btn success-btn">
      Book Another Slot
    </a>
  </div>
</div>