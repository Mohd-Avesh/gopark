<%- layout("/layouts/boilerplate.ejs") %>

<!-- ================= ABOUT HERO ================= -->
<section class="about-hero-section py-5 text-center">
  <div class="container">
    <h1 class="about-main-title fw-bold display-5">
      About <span class="brand-highlight">Go-Park</span>
    </h1>
    <p class="about-subtitle lead text-muted mt-3">
      Smart, secure, and hassle-free parking solutions designed for modern cities.
    </p>
  </div>
</section>

<!-- ================= OUR STORY ================= -->
<section class="about-story-section py-5">
  <div class="container">
    <div class="row align-items-center g-5">
      <div class="col-md-6">
        <h2 class="section-heading mb-4">Our Story</h2>
        <p class="text-muted">
          Go-Park was created to solve one of the most common urban problems —
          finding a reliable parking space quickly and efficiently.
        </p>
        <p class="text-muted">
          Our platform allows users to search parking slots by location,
          select date and time, calculate pricing automatically, and
          securely book their parking spot within seconds.
        </p>
      </div>
      <div class="col-md-6 text-center">
        <img src="https://images.unsplash.com/photo-1506521781263-d8422e82f27a" class="img-fluid rounded shadow-lg about-story-image" alt="Parking">
      </div>
    </div>
  </div>
</section>

<!-- ================= OUR MISSION ================= -->
<section class="about-mission-section py-5">
  <div class="container text-center">
    <h2 class="section-heading mb-4">Our Mission</h2>
    <p class="mission-description text-muted mx-auto">
      To simplify parking management using smart technology,
      time-based pricing automation, and real-time availability tracking.
      We aim to reduce traffic congestion and save valuable time for drivers.
    </p>
  </div>
</section>


<!-- ================= FEATURES ================= -->
<section class="about-features-section py-5">
  <div class="container">
    <h2 class="section-heading fw-bold text-center mb-5">What We Offer</h2>
    <div class="row g-4">

      <div class="col-md-4">
        <div class="feature-card card h-100 shadow-sm border-0 p-4 text-center">
          <i class="bi bi-search feature-icon fs-1 text-secondary mb-3"></i>
          <h5 class="fw-semibold">Smart Search</h5>
          <p class="text-muted small">
            Quickly find parking slots by city or area using our optimized search system.
          </p>
        </div>
      </div>

      <div class="col-md-4">
        <div class="feature-card card h-100 shadow-sm border-0 p-4 text-center">
          <i class="bi bi-clock feature-icon fs-1 text-secondary mb-3"></i>
          <h5 class="fw-semibold">Time-Based Pricing</h5>
          <p class="text-muted small">
            Automatic price calculation based on selected start and end time.
          </p>
        </div>
      </div>

      <div class="col-md-4">
        <div class="feature-card card h-100 shadow-sm border-0 p-4 text-center">
          <i class="bi bi-shield-lock feature-icon fs-1 text-secondary mb-3"></i>
          <h5 class="fw-semibold">Secure Booking</h5>
          <p class="text-muted small">
            Safe booking with vehicle validation and protected user authentication.
          </p>
        </div>
      </div>

      <div class="col-md-4">
        <div class="feature-card card h-100 shadow-sm border-0 p-4 text-center">
          <i class="bi bi-calendar-check feature-icon fs-1 text-secondary mb-3"></i>
          <h5 class="fw-semibold">Availability Management</h5>
          <p class="text-muted small">
            Real-time conflict detection prevents double bookings.
          </p>
        </div>
      </div>

      <div class="col-md-4">
        <div class="feature-card card h-100 shadow-sm border-0 p-4 text-center">
          <i class="bi bi-layout-text-window feature-icon fs-1 text-secondary mb-3"></i>
          <h5 class="fw-semibold">Booking Dashboard</h5>
          <p class="text-muted small">
            Manage all bookings from a clean and organized dashboard.
          </p>
        </div>
      </div>

      <div class="col-md-4">
        <div class="feature-card card h-100 shadow-sm border-0 p-4 text-center">
          <i class="bi bi-lightning-charge feature-icon fs-1 text-secondary mb-3"></i>
          <h5 class="fw-semibold">Fast & Responsive</h5>
          <p class="text-muted small">
            Optimized UI built for smooth performance on all devices.
          </p>
        </div>
      </div>

    </div>
  </div>
</section>

<!-- ================= WHY CHOOSE US ================= -->
<section class="why-go-park-section py-5">
  <div class="container">
    <div class="text-center mb-5">
      <h2 class="section-heading fw-bold">Why Go-Park Stands Out</h2>
      <p class="text-muted why-subtitle">
        Go-Park is designed to simplify parking management with smart technology,
        reliable booking logic, and a seamless user experience.
      </p>
    </div>

    <div class="row g-4">

      <div class="col-md-4">
        <div class="why-card text-center p-4 rounded shadow-sm h-100">
          <h6 class="fw-semibold mb-2">Transparent Pricing</h6>
          <p class="text-muted small">
            Clear time-based pricing ensures users know exactly what they are paying for.
          </p>
        </div>
      </div>

      <div class="col-md-4">
        <div class="why-card text-center p-4 rounded shadow-sm h-100">
          <h6 class="fw-semibold mb-2">Real-Time Availability</h6>
          <p class="text-muted small">
            Booking conflict detection prevents double reservations.
          </p>
        </div>
      </div>

      <div class="col-md-4">
        <div class="why-card text-center p-4 rounded shadow-sm h-100">
          <h6 class="fw-semibold mb-2">Secure & Structured System</h6>
          <p class="text-muted small">
            Built with proper authentication and data validation for reliability.
          </p>
        </div>
      </div>

    </div>
  </div>
</section>

<!-- ================= CONTACT CTA ================= -->
<section class="about-cta-section py-5 text-center">
  <div class="container">
    <h2 class="fw-bold">Ready to Park Smarter?</h2>
    <p class="text-muted">Start booking your parking spot today with Go-Park.</p>
    <a href="/parking-slots" class="btn btn-lg teal-main-btn explore-slots-btn">
      Explore Parking Slots
    </a>
  </div>
</section>