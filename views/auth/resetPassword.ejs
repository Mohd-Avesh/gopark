<%- layout("/layouts/boilerplate.ejs") %>

<section class="login-section vh-100 d-flex align-items-center justify-content-center mb-5">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-md-8 col-lg-5">

        <div class="card login-card shadow-lg border-0 rounded-4 p-4">

          <!-- Heading -->
          <div class="text-center mb-1">
            <h2 class="fw-bold text-dark mb-2">
              Reset <span class="brand-text">Password</span>
            </h2>
            <p class="fs-6 fw-semibold text-muted">Enter your new password below</p>
          </div>

          <!-- Error Message -->
          <% if (typeof error !== "undefined" && error) { %>
          <div class="error-container text-center rounded-3" id="error-conn">
            <%= error %>
          </div>
          <% } %>

          <!-- Success Message -->
          <% if (typeof success !== "undefined" && success) { %>
          <div class=" rounded-3 success-container text-center">
            <%= success %>
          </div>
          <% } %>

          <!-- Form -->
          <form action="/auth/reset-password/<%= token %>" method="POST" novalidate id="resetForm">

            <!-- New Password -->
            <div class="mb-3">
              <label class="form-label fw-semibold">New Password</label>
              <input type="password" name="password" id="password" class="form-control rounded-3 slot-main-input" placeholder="Enter new password" />
              <small class="text-danger error-message" id="passwordError"></small>
            </div>

            <!-- Confirm Password -->
            <div class="mb-3">
              <label class="form-label fw-semibold">Confirm Password</label>
              <input type="password" id="confirmPassword" class="form-control rounded-3 slot-main-input" placeholder="Confirm new password" />
              <small class="text-danger error-message" id="confirmPasswordError"></small>
            </div>

            <!-- Button -->
            <div class="d-grid">
              <button type="submit" class="btn btn-lg login-btn teal-main-btn rounded-3">
                Reset Password
              </button>
            </div>

          </form>

          <!-- Back -->
          <div class="text-center mt-4">
            <a href="/auth/login" class=" text-decoration-none register-link fw-semibold">
              Back to Login
            </a>
          </div>

        </div>

      </div>
    </div>
  </div>
</section>
<script src="/js/inputField.js"></script>
<script src="/js/resetPass.js"></script>