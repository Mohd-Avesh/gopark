<%- layout("/layouts/boilerplate.ejs") %>

<section class="login-section vh-100 d-flex align-items-center justify-content-center mb-5">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-md-6 col-lg-4 col-8">

        <div class="card login-card shadow-lg border-0 rounded-4 p-4">

          <div class="text-center">
            <h2 class="fw-bold text-dark">
              Forgot <span class="brand-text">Password</span>
            </h2>
            <p class="text-muted">We'll send you a reset link</p>
          </div>

          <% if (typeof error !== "undefined" && error) { %>
          <div class="error-container text-center rounded-3">
            <%= error %>
          </div>
          <% } %>

          <% if (typeof success !== "undefined" && success) { %>
          <div class="success-color text-center mb-2">
            <%= success %>
          </div>
          <% } %>

          <form action="/auth/forgot-password" method="POST" novalidate id="forgotForm" autocomplete="off">

            <!-- Autofill block -->
            <input type="text" name="fakeuser" style="display:none">
            <input type="password" name="fakepass" style="display:none">

            <div class="mb-3">
              <label class="form-label fw-semibold">Email Address</label>
              <input type="text" name="email" id="forgotEmail" class="form-control rounded-3 slot-main-input" placeholder="Enter your email" autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false" />
              <small class="text-danger error-message" id="forgotEmailError"></small>
            </div>

            <div class="d-grid">
              <button type="submit" class="btn btn-lg login-btn teal-main-btn rounded-3">
                Send Reset Link
              </button>
            </div>

          </form>

          <div class="text-center mt-4">
            <p class="text-muted">
              Remember your password?
              <a href="/auth/login" class="register-link fw-semibold text-decoration-none">
                Login Here
              </a>
            </p>
          </div>

        </div>

      </div>
    </div>
  </div>
</section>

<script src="/js/forgotEmail.js" defer></script>
<script src="/js/inputField.js"></script>