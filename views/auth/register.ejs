<%- layout("/layouts/boilerplate.ejs") %>
<section class="login-section d-flex align-items-center justify-content-center pt-5 pb-5">
  <div class="container main-container pt-4">
    <div class="row justify-content-center">
      <div class="col-md-6 col-lg-5">

        <div class="card login-card shadow-lg border-0 rounded-4 p-4">
          <div class="text-center mb-2">
            <h2 class="fw-bold text-dark">
              Create <span class="brand-text">Go-Park</span> Account
            </h2>
            <p class="text-muted">Register to book and manage parking slots</p>
          </div>
          <% if (typeof error !== "undefined" && error) { %>
          <div class="error-container text-center rounded-3">
            <%= error %>
          </div>
          <% } %>

          <!-- FORM START -->
          <form action="/auth/register" method="POST" novalidate id="registerForm">

            <!-- Full Name -->
            <div class="mb-3">
              <label class="form-label fw-semibold ">Full Name</label>
              <input type="text" name="name" id="name" class="form-control rounded-3 slot-main-input" value="<%= typeof oldInput !== 'undefined' ? oldInput.name : '' %>" placeholder="Enter your full name" />
              <small class="text-danger error-message" id="nameError"></small>
            </div>

            <!-- Email -->
            <div class="mb-3">
              <label class="form-label fw-semibold">Email Address</label>
              <input type="text" name="email" id="email" class="form-control rounded-3 slot-main-input" value="<%= typeof oldInput !== 'undefined' ? oldInput.email : '' %>" placeholder="Enter your email" />
              <small class="text-danger error-message" id="emailError"></small>
            </div>

            <!-- Phone -->
            <div class="mb-3">
              <label class="form-label fw-semibold">Phone Number</label>
              <input type="tel" name="phone" id="phone" class="form-control rounded-3 slot-main-input" value="<%= typeof oldInput !== 'undefined' ? oldInput.phone : '' %>" placeholder="Enter 10-digit mobile number" maxlength="10" />
              <small class="text-danger error-message" id="phoneError"></small>
            </div>

            <!-- Password -->
            <div class="mb-3">
              <label class="form-label fw-semibold">Password</label>
              <input type="password" name="password" id="password" class="form-control rounded-3 slot-main-input" placeholder="Create a secure password" />
              <small class="text-danger error-message" id="passwordError"></small>
            </div>

            <!-- Confirm Password -->
            <div class="mb-4">
              <label class="form-label fw-semibold">Confirm Password</label>
              <input type="password" name="confirmPassword" id="confirmPassword" class="form-control rounded-3 slot-main-input" placeholder="Confirm your password" />
              <small class="text-danger error-message" id="confirmPasswordError"></small>
            </div>

            <div class="d-grid">
              <button type="submit" class="btn btn-lg teal-main-btn">
                Register
              </button>
            </div>

          </form>
          <!-- FORM END -->

          <div class="text-center mt-4">
            <p class="text-muted">
              Already have an account?
              <a href="/auth/login" class="register-link fw-semibold text-decoration-none" style="color: #008080;">
                Login Here
              </a>
            </p>
          </div>

        </div>

      </div>
    </div>
  </div>
</section>
<script src="/js/register.js" defer></script>
<script src="/js/inputField.js"></script>